---
import { i18n } from '../data/i18n';
import { news } from '../data/news';

interface Props {
  limit?: number;
  showHeader?: boolean;
}
const { limit, showHeader = true } = Astro.props;

// Sort by date descending
const sorted = [...news].sort((a, b) => b.date.localeCompare(a.date));
const items = limit ? sorted.slice(0, limit) : sorted;

const formatDate = (iso: string) => {
  const [y, m] = iso.split('-');
  return `${y}.${m}`;
};
---

<section id="news">
  {showHeader && (
    <div class="section-head">
      <h2>
        <span class="zh-only">{i18n.sections.news.zh}</span>
        <span class="en-only">{i18n.sections.news.en}</span>
      </h2>
    </div>
  )}
  <div class="news-grid">
    {items.map(item => (
      <div class="news-row">
        <span class="news-date">{formatDate(item.date)}</span>
        <span class="news-body">
          <span class="zh-only" set:html={item.zh}></span>
          <span class="en-only" set:html={item.en}></span>
        </span>
      </div>
    ))}
  </div>
</section>
