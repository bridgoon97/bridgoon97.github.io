---
import { i18n } from '../data/i18n';
import { site } from '../data/site';
---

<section id="contact">
  <div class="section-head">
    <h2>
      <span class="zh-only">{i18n.sections.contact.zh}</span>
      <span class="en-only">{i18n.sections.contact.en}</span>
    </h2>
  </div>
  <div class="contact-icons">
    <a href={`mailto:${site.social.email}`} title="email" aria-label="email">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 5h18v14H3z"/><path d="M3 5l9 8 9-8"/></svg>
    </a>
    <a href={site.social.scholar} title="Google Scholar" aria-label="Google Scholar">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269A8 8 0 0 0 12 7.6a8 8 0 0 0-6.758 6.169zM12 10a7 7 0 1 1 0 14 7 7 0 0 1 0-14z"/></svg>
    </a>
    <a href={site.social.github} title="GitHub" aria-label="GitHub">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.11 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 0z"/></svg>
    </a>
    <a href={site.social.twitter} title="Twitter" aria-label="Twitter">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2H21.5l-7.5 8.575L23 22h-6.93l-5.43-7.108L4.4 22H1.14l8.024-9.17L1 2h7.094l4.913 6.493L18.244 2zm-2.43 18h1.84L8.27 4h-1.97l9.514 16z"/></svg>
    </a>
    <a href={site.social.linkedin} title="LinkedIn" aria-label="LinkedIn">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8.339 18.337v-8.59H5.667v8.59h2.672zM7.003 8.574a1.548 1.548 0 1 0 0-3.096 1.548 1.548 0 0 0 0 3.096zm11.335 9.763v-4.706c0-2.32-.502-4.107-3.213-4.107-1.305 0-2.18.717-2.537 1.394h-.036v-1.18H9.99v8.59h2.672v-4.253c0-1.121.214-2.207 1.605-2.207 1.37 0 1.389 1.282 1.389 2.279v4.18h2.682z"/></svg>
    </a>
  </div>
</section>
